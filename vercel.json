{
  "buildCommand": "cd example && npm run build",
  "outputDirectory": "example/dist",
  "redirects": [
    {
      "source": "/",
      "destination": "https://sholajegede.com/demos/convex-paystack",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/demos/convex-paystack/:path*",
      "destination": "/:path*"
    }
  ]
}
